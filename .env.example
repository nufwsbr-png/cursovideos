# Copie para .env e preencha. NUNCA coloque este arquivo preenchido no git nem no cérebro.

# IA que escreve e critica os roteiros (Anthropic)
ANTHROPIC_API_KEY=
# CLAUDE_MODELO=claude-opus-5-5

# Vozes (Gemini TTS — o mesmo motor do Google AI Studio)
GEMINI_API_KEY=
# GEMINI_TTS_MODELO=gemini-2.5-flash-preview-tts

# Transcrição (opcional). WHISPER_MODELO=small | base | medium ; WHISPER_DESLIGADO=1 para pular
# WHISPER_MODELO=small

# Motor: MOTOR_GPU=1 na máquina com placa de vídeo
# MOTOR_GPU=1
# CHROME_PATH=  (só se o Playwright não achar o Chromium)

# TikTok (Content Posting API) — ver docs/CREDENCIAIS.md
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=

# Meta (Instagram Reels + Facebook Reels)
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
IG_USER_ID=

# YouTube (Data API v3)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Hospedagem do MP4 em URL pública (o Instagram exige). Supabase Storage ou GitHub Release.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# GITHUB_TOKEN=
# GITHUB_REPOSITORY=usuario/repositorio

# Kwai: navegador (sessão própria) ou fila_manual
KWAI_MODO=fila_manual
