  "falas": [
    { "id": "f01", "quem": "dalva", "voz": "Gacrux", "texto": "Novato, a impressora ligou sozinha de novo.", "estilo": "dry, teasing, not looking up from the mop", "filtro": null, "reaproveitar_de": null },
    { "id": "f02", "quem": "eu", "voz": "Iapetus", "texto": "Eu nem encostei.", "estilo": "defensive, quick", "filtro": null, "reaproveitar_de": null },
    { "id": "f03", "quem": "dalva", "voz": "Gacrux", "texto": "Sistema velho. Rasga e pronto.", "estilo": "bored, dismissive", "filtro": null, "reaproveitar_de": null },
    { "id": "f04", "quem": "eu", "voz": "Iapetus", "texto": "Tá escrito plataforma sete.", "estilo": "unsure, low", "filtro": null, "reaproveitar_de": null },
    { "id": "f05", "quem": "dalva", "voz": "Gacrux", "texto": "Só tem quatro. Sempre teve.", "estilo": "firm, a bit too fast", "filtro": null, "reaproveitar_de": null },
    { "id": "f06", "quem": "alto_falante", "voz": "Erinome", "texto": "Embarque imediato. Plataforma sete.", "estilo": "cold, flat announcement", "filtro": "alto_falante", "reaproveitar_de": null },
    { "id": "f07", "quem": "dalva", "voz": "Gacrux", "texto": "Ninguém gravou isso, novato.", "estilo": "the joke is gone, quiet", "filtro": null, "reaproveitar_de": null },
    { "id": "f08", "quem": "amaral", "voz": "Algenib", "texto": "A passagem saiu?", "estilo": "tired, already knows the answer", "filtro": "telefone", "reaproveitar_de": null },
    { "id": "f09", "quem": "eu", "voz": "Iapetus", "texto": "Saiu sozinha.", "estilo": "barely a whisper", "filtro": null, "reaproveitar_de": null },
    { "id": "f10", "quem": "amaral", "voz": "Algenib", "texto": "Leva pro guarda-volumes. Armário sete.", "estilo": "slow, firm, an order", "filtro": "telefone", "reaproveitar_de": null },
    { "id": "f11", "quem": "amaral", "voz": "Algenib", "texto": "E não lê a etiqueta, menino.", "estilo": "very calm, heavy, a warning", "filtro": "telefone", "reaproveitar_de": null },
    { "id": "f12", "quem": "eu", "voz": "Iapetus", "texto": "Neusa... é a minha mãe.", "estilo": "whisper, breaking", "filtro": null, "reaproveitar_de": null },
    { "id": "f13", "quem": "passageiro", "voz": "Schedar", "texto": "Boa noite, moço.", "estilo": "polite, soft, no hurry", "filtro": null, "reaproveitar_de": null },
    { "id": "f14", "quem": "passageiro", "voz": "Schedar", "texto": "Vim buscar a passagem dela.", "estilo": "polite, patient", "filtro": null, "reaproveitar_de": null },
    { "id": "f15", "quem": "dalva", "voz": "Gacrux", "texto": "Não entrega, novato.", "estilo": "whisper, urgent", "filtro": null, "reaproveitar_de": null },
    { "id": "f16", "quem": "dalva", "voz": "Gacrux", "texto": "Da última vez que ela ligou sozinha...", "estilo": "slow whisper, remembering", "filtro": null, "reaproveitar_de": null },
    { "id": "f17", "quem": "dalva", "voz": "Gacrux", "texto": "...alguém não voltou.", "estilo": "almost no voice", "filtro": null, "reaproveitar_de": null },
    { "id": "f18", "quem": "passageiro", "voz": "Schedar", "texto": "Se não entregar, ela fica na estrada.", "estilo": "kind, calm, matter-of-fact", "filtro": null, "reaproveitar_de": null },
    { "id": "f19", "quem": "passageiro", "voz": "Schedar", "texto": "O das três não atrasa.", "estilo": "gentle, final", "filtro": null, "reaproveitar_de": null }
